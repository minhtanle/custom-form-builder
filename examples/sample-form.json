{
  "name": "Mẫu form đầy đủ input",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "ho_ten": {
        "title": {
          "vi": "Họ tên",
          "en": "Full name"
        },
        "type": "string",
        "minLength": 2,
        "maxLength": 50
      },
      "email": {
        "title": {
          "vi": "Email",
          "en": "Email"
        },
        "type": "string",
        "format": "email"
      },
      "so_dt": {
        "title": {
          "vi": "Số điện thoại",
          "en": "Phone number"
        },
        "type": "string",
        "format": "phone"
      },
      "website": {
        "title": {
          "vi": "Website cá nhân",
          "en": "Website cá nhân"
        },
        "type": "string",
        "format": "uri"
      },
      "dia_chi": {
        "title": {
          "vi": "Địa chỉ",
          "en": "Address"
        },
        "type": "string"
      },
      "nam_sinh": {
        "title": {
          "vi": "Năm sinh",
          "en": "Năm sinh"
        },
        "type": "number",
        "minimum": 1900,
        "maximum": 2026,
        "default": 1995
      },
      "so_luong": {
        "title": {
          "vi": "Số lượng",
          "en": "Số lượng"
        },
        "type": "number",
        "minimum": 1,
        "maximum": 100,
        "default": 1
      },
      "ghi_chu": {
        "title": {
          "vi": "Ghi chú",
          "en": "Note"
        },
        "type": "string",
        "maxLength": 500
      },
      "ngay_bd": {
        "title": {
          "vi": "Ngày bắt đầu",
          "en": "Ngày bắt đầu"
        },
        "type": "string",
        "format": "date",
        "default": "2026-01-01"
      },
      "ngay_kt": {
        "title": {
          "vi": "Ngày kết thúc",
          "en": "Ngày kết thúc"
        },
        "type": "string",
        "format": "date",
        "formatMaximum": "2026-12-31"
      },
      "gio_bd": {
        "title": {
          "vi": "Giờ bắt đầu (8h = 480 phút)",
          "en": "Giờ bắt đầu (8h = 480 phút)"
        },
        "type": "number",
        "minimum": 0,
        "maximum": 43200,
        "default": 28800
      },
      "khu_vuc": {
        "title": {
          "vi": "Khu vực",
          "en": "Region"
        },
        "type": "string",
        "oneOf": [
          {
            "const": "ts",
            "title": {
              "vi": "Trụ sở",
              "en": "Headquarters"
            }
          },
          {
            "const": "cn",
            "title": {
              "vi": "Chi nhánh",
              "en": "Branch"
            }
          }
        ],
        "default": "ts"
      },
      "doi_tuong": {
        "title": {
          "vi": "Đối tượng",
          "en": "Target"
        },
        "type": "integer",
        "oneOf": [
          {
            "const": 1,
            "title": {
              "vi": "Thành viên",
              "en": "Member"
            }
          },
          {
            "const": 2,
            "title": {
              "vi": "Khách hàng",
              "en": "Customer"
            }
          },
          {
            "const": 3,
            "title": {
              "vi": "Khác",
              "en": "Other"
            }
          }
        ],
        "default": 1
      },
      "ma_thanh_vien": {
        "title": {
          "vi": "Mã thành viên",
          "en": "Mã thành viên"
        },
        "type": "string"
      },
      "cap_do": {
        "title": {
          "vi": "Cấp độ",
          "en": "Cấp độ"
        },
        "type": "string",
        "oneOf": [
          {
            "const": "vip",
            "title": {
              "vi": "VIP",
              "en": "VIP"
            }
          },
          {
            "const": "normal",
            "title": {
              "vi": "Thường",
              "en": "Thường"
            }
          }
        ]
      },
      "ten_cong_ty": {
        "title": {
          "vi": "Tên công ty",
          "en": "Tên công ty"
        },
        "type": "string"
      },
      "so_nv": {
        "title": {
          "vi": "Số nhân viên",
          "en": "Số nhân viên"
        },
        "type": "number",
        "minimum": 1,
        "maximum": 9999
      },
      "dong_y": {
        "title": {
          "vi": "Tôi đồng ý với <a href=\"https://example.com\">Điều khoản</a>",
          "en": "Tôi đồng ý với <a href=\"https://example.com\">Điều khoản</a>"
        },
        "type": "boolean"
      },
      "token": {
        "title": {
          "vi": "Token",
          "en": "Token"
        },
        "type": "string",
        "default": "abc123"
      }
    },
    "required": [
      "ho_ten",
      "email",
      "dong_y"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "doi_tuong": {
              "const": 1
            }
          }
        },
        "then": {
          "required": [
            "ma_thanh_vien",
            "cap_do"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "doi_tuong": {
              "const": 2
            }
          }
        },
        "then": {
          "required": [
            "ten_cong_ty",
            "so_nv"
          ]
        }
      }
    ]
  },
  "uiSchema": {
    "idPrefix": "mf",
    "fields": {
      "ho_ten": {
        "ui:widget": "text"
      },
      "email": {
        "ui:widget": "text"
      },
      "so_dt": {
        "ui:widget": "text"
      },
      "website": {
        "ui:widget": "text"
      },
      "dia_chi": {
        "ui:widget": "text"
      },
      "nam_sinh": {
        "ui:widget": "text"
      },
      "so_luong": {
        "ui:widget": "text"
      },
      "ghi_chu": {
        "ui:widget": "text"
      },
      "ngay_bd": {
        "ui:widget": "text"
      },
      "ngay_kt": {
        "ui:widget": "text"
      },
      "gio_bd": {
        "ui:widget": "time-slider"
      },
      "khu_vuc": {
        "ui:widget": "custom-select"
      },
      "doi_tuong": {
        "ui:widget": "radio"
      },
      "ma_thanh_vien": {
        "ui:widget": "text",
        "ui:grid": 6
      },
      "cap_do": {
        "ui:widget": "custom-select",
        "ui:grid": 6
      },
      "ten_cong_ty": {
        "ui:widget": "text",
        "ui:grid": 6
      },
      "so_nv": {
        "ui:widget": "text",
        "ui:grid": 6
      },
      "dong_y": {
        "ui:widget": "checkbox"
      }
    },
    "layout": [
      {
        "type": "row",
        "fields": [],
        "layoutElement": {
          "type": "heading",
          "text": {
            "vi": "Thông tin đăng ký",
            "en": "Registration info"
          }
        }
      },
      {
        "type": "row",
        "fields": [],
        "layoutElement": {
          "type": "paragraph",
          "text": {
            "vi": "Vui lòng điền đầy đủ thông tin. Xem <a href=\"https://example.com\">Điều khoản sử dụng</a>.",
            "en": "Please fill in all fields. See <a href=\"https://example.com\">Terms of use</a>."
          }
        }
      },
      {
        "type": "row",
        "fields": [
          {
            "name": "ho_ten",
            "grid": 6
          },
          {
            "name": "email",
            "grid": 6
          }
        ]
      },
      {
        "type": "row",
        "fields": [
          {
            "name": "so_dt",
            "grid": 6
          },
          {
            "name": "website",
            "grid": 6
          }
        ]
      },
      {
        "type": "row",
        "fields": [
          {
            "name": "dia_chi",
            "grid": 12
          }
        ]
      },
      {
        "type": "row",
        "fields": [
          {
            "name": "nam_sinh",
            "grid": 6
          },
          {
            "name": "so_luong",
            "grid": 6
          }
        ]
      },
      {
        "type": "row",
        "fields": [
          {
            "name": "ghi_chu",
            "grid": 12
          }
        ]
      },
      {
        "type": "row",
        "fields": [
          {
            "name": "ngay_bd",
            "grid": 6
          },
          {
            "name": "ngay_kt",
            "grid": 6
          }
        ]
      },
      {
        "type": "row",
        "fields": [
          {
            "name": "gio_bd",
            "grid": 6
          }
        ]
      },
      {
        "type": "row",
        "fields": [
          {
            "name": "khu_vuc",
            "grid": 12
          }
        ]
      },
      {
        "type": "row",
        "fields": [
          {
            "name": "doi_tuong",
            "grid": 12
          }
        ]
      },
      {
        "type": "row",
        "fields": [
          {
            "name": "dong_y",
            "grid": 12
          }
        ]
      },
      {
        "type": "row",
        "fields": [],
        "layoutElement": {
          "type": "divider",
          "text": "Divider"
        }
      }
    ]
  },
  "optionKeys": []
}
